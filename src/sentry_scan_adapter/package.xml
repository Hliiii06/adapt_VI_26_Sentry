<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sentry_scan_adapter</name>
  <version>0.1.0</version>
  <description>
    RM → SCAN 薄输入适配与影子保护层。只做数据适配、健康门控与影子记录；
    不启动 UART/Nav2/LIO/registration，不向底盘或 /cmd_vel 发布任何命令。
    契约与边界见 docs/interfaces/shadow_input_contract.md。
  </description>
  <maintainer email="dev@example.com">adapt_VI_26_Sentry</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_sensor_msgs</depend>
  <depend>scan_planner_msgs</depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
